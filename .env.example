# PathMatch AI - Environment Configuration
# SIH25034 — LLM-Powered Internship Role Recommendation Engine

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=pathmatch-super-secret-key-change-in-production-2025

# Database Configuration
DATABASE_PATH=data/pathmatch.db

# LLM Provider Configuration: 'openai', 'groq', 'ollama', or 'demo'
# If set to 'demo' or if keys are missing, the system gracefully operates in DEMO MODE with clear UI labeling.
LLM_PROVIDER=demo

# OpenAI API Configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Groq API Configuration
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama Local Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Application Settings
MAX_CANDIDATE_OCCUPATIONS=12
DEFAULT_RECOMMENDATION_LIMIT=6
REQUEST_TIMEOUT_SECONDS=30
MAX_REQUEST_RETRIES=2

